{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unified-workforce-api",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workforce",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ],
  // NOTE: R2 (document file storage) removed for now — requires enabling
  // through the Cloudflare Dashboard. Re-add when needed for Phase 4:
  // "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "workforce-documents" }],
  "vars": {
    // Change this to a long random string before deploying!
    "AUTH_SECRET": "dev-only-secret-change-me"
  }
}
